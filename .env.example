ODOO_IMAGE_TAG=18.0
ODOO_MASTER_PASSWORD=replace_with_secure_random_master_password_32chars
WITHOUT_DEMO=True

LOCAL_HTTP_PORT=8080

# Cloudflare Tunnel Configuration (Optional Compose Profile)
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_HOSTNAME=

